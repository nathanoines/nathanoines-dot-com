# Enable MIME types for modern JavaScript
AddType application/javascript .js
AddType text/css .css
AddType image/svg+xml .svg

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Proxy IFPA API requests through PHP
  RewriteCond %{REQUEST_URI} ^/api/ifpa/(.*)$
  RewriteRule ^api/ifpa/(.*)$ /api-proxy.php?path=$1&%{QUERY_STRING} [L]

  # Serve everything from dist/ unless it's the API proxy or dist itself
  RewriteCond %{REQUEST_URI} !^/api-proxy\.php
  RewriteCond %{REQUEST_URI} !^/dist/
  RewriteCond %{DOCUMENT_ROOT}/dist%{REQUEST_URI} -f
  RewriteRule ^(.*)$ /dist/$1 [L]

  # Fallback: serve dist/index.html for SPA routes
  RewriteCond %{REQUEST_URI} !^/api-proxy\.php
  RewriteCond %{REQUEST_URI} !^/api/ifpa/
  RewriteCond %{REQUEST_URI} !^/dist/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.*)$ /dist/index.html [L]
</IfModule>

# Enable gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript
</IfModule>
